{
  "database": "data/library.sqlite3",
  "sources": [
    {
      "name": "webclips",
      "type": "clipper",
      "path": "C:/Library/clipper.sqlite3",
      "closed_snapshot": false
    },
    {
      "name": "papers",
      "type": "folder",
      "path": "C:/Library/PDFs",
      "ascii_ratio": 0.8,
      "min_words": 20,
      "max_file_mb": 200,
      "max_pages": 2000
    }
  ],
  "model": {
    "path": "C:/Models/model.gguf",
    "context": 12000,
    "output": 2000,
    "gpu_layers": 0,
    "thinking": false,
    "cache_k": "f16",
    "cache_v": "f16",
    "flash_attention": false,
    "kv_offload": true
  },
  "database_options": {
    "cache_mb": 32
  },
  "reranker": {
    "enabled": false,
    "model_dir": "",
    "device": "cpu",
    "candidates": 40,
    "top_k": 5,
    "batch_size": 8,
    "threads": 2,
    "max_pair_tokens": 512,
    "timeout_seconds": 5,
    "startup_seconds": 60
  },
  "agent_options": {
    "note_tokens": 6000,
    "effort": "legacy"
  },
  "search_input_mode": "simple",
  "library_sync": {"enabled": false, "auto_sync": false},
  "pdf_viewer": {"enabled": false, "viewer": "acrobat", "executable": ""}
}
